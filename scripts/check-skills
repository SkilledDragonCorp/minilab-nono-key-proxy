#!/usr/bin/env bash
# Fail when skills layout / frontmatter rules are violated.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
fail=0

for forbidden in .cursor/skills .agents/skills; do
  if [[ -e "$ROOT/$forbidden" ]]; then
    echo "ERROR: skills must live only under .claude/skills — found $forbidden"
    fail=1
  fi
done

if [[ ! -d "$ROOT/.claude/skills" ]]; then
  echo "ERROR: missing .claude/skills"
  exit 1
fi

# Any SKILL.md outside .claude/skills is forbidden.
while IFS= read -r -d '' skill_file; do
  rel="${skill_file#"$ROOT"/}"
  case "$rel" in
    .claude/skills/*/SKILL.md) ;;
    *)
      echo "ERROR: SKILL.md outside .claude/skills/: $rel"
      fail=1
      ;;
  esac
done < <(find "$ROOT" -name SKILL.md -print0 2>/dev/null | grep -zv '/upstream/' || true)

for skill_dir in "$ROOT"/.claude/skills/*/; do
  [[ -d "$skill_dir" ]] || continue
  name="$(basename "$skill_dir")"
  skill_file="$skill_dir/SKILL.md"
  if [[ ! -f "$skill_file" ]]; then
    echo "ERROR: missing SKILL.md in $skill_dir"
    fail=1
    continue
  fi
  if ! head -1 "$skill_file" | grep -q '^---$'; then
    echo "ERROR: missing YAML frontmatter in $skill_file"
    fail=1
    continue
  fi
  front_name="$(sed -n 's/^name:[[:space:]]*//p' "$skill_file" | head -1 | tr -d '\r"')"
  desc="$(sed -n 's/^description:[[:space:]]*//p' "$skill_file" | head -1 | tr -d '\r')"
  if [[ "$front_name" != "$name" ]]; then
    echo "ERROR: frontmatter name '$front_name' != folder '$name'"
    fail=1
  fi
  if [[ -z "$desc" ]]; then
    echo "ERROR: empty description in $skill_file"
    fail=1
  fi
done

exit "$fail"
