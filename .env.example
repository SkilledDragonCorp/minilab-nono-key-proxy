# Lab mock upstream token (required for keyproxy-lab serve-mock / e2e harness sets this itself)
LAB_UPSTREAM_TOKEN=

# Optional live demo: fine-grained GitHub PAT, Metadata read-only, injected only via nono proxy
GITHUB_TOKEN=

# nono opt-outs (recommended for CI / automation)
NONO_NO_UPDATE_CHECK=1
NONO_NO_SAVE_PROMPT=1
NONO_NO_MIGRATE=1
NONO_NO_PACK_UPDATE_HINTS=1
DO_NOT_TRACK=1
